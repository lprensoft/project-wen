# 密钥与本地配置
.env
config.yaml

# 本地会话数据与运行时状态（models.json 含明文 API Key）
sessions/
plugins.state.json
models.json
auth.json
wen.lock

# 插件的持久化目录（记忆条目与压缩归档等；锚定根目录，源码在 internal/plugin/ 下不受影响）
/plugins/

# 构建产物与运行日志（锚定根目录，避免误伤 cmd/wen/）
/wen
/wen.exe
*.log
/wen.exe~

# 分发打包产物（发布 workflow 在这两处落地，本地跑同一套脚本时也一样）
/dist/
/build/
